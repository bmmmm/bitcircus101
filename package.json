{
  "name": "bitcircus101",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm/')){console.error('\\n  bitcircus101 is pnpm-only (supply-chain policy). Use: pnpm install - npm/yarn are blocked.\\n');process.exit(1)}\"",
    "build:layout": "node scripts/inject-layout.mjs",
    "build:logos": "node scripts/build-logo-slider.mjs",
    "build:lite-events": "node scripts/build-lite-events.mjs",
    "build:lite-finanz": "node scripts/build-lite-finanz.mjs",
    "check:calendars": "node scripts/check-calendars.mjs",
    "check:jobs": "node scripts/check-jobs.mjs",
    "finanz": "node scripts/finanz.mjs",
    "finanz:validate": "node scripts/finanz.mjs validate",
    "build": "pnpm run build:layout && pnpm run build:logos && pnpm run build:lite-finanz",
    "test": "node --test tests/*.spec.mjs && playwright test",
    "test:quick": "node --test tests/*.spec.mjs",
    "test:unit": "node --test tests/*.spec.mjs",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
