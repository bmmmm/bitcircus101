    {
      "id": "e45639019f6b",
      "title": "Linkup@bitcircus101",
      "subtitle": "",
      "description": "Linkup@bitcircus101 is our signature monthly meetup for anyone in Bonn’s tech scene to come together, share ideas and unwind. Every third Friday of the month starting at 8 PM, we kick things off with a series of lightning talks—short, punchy presentations (3 slides in 3 minutes each) where people can showcase a project, demo a tool or pose a new question. After the talks, the formal program wraps up and we transition into an open, relaxed hangout: you can grab a drink or snack, pull up a chair and dive into conversations with fellow tech-enthusiasts in a friendly, low-pressure atmosphere.\n\nOn all the other Fridays, we host Casual Linkup at the same time—no talks, just a laid-back environment to brainstorm, get feedback, troubleshoot problems or simply meet others who love technology. Whether you’re here to present or to listen, to ask questions or to offer advice, Linkup is all about building real human connections around shared tech interests",
      "location": "Dorotheenstraße 101, 53111 Bonn",
      "date": "2026-11-20",
      "time": "20:00",
      "endDate": "2026-11-20",
      "endTime": "22:30",
      "tags": [
        "#meetup",
        "#lightning-talks",
        "#talk"
      ],
      "type": "linkup",
      "source": "bitcircus101",
      "uid": "19471ECE-D83E-4AA6-B70D-545B3F281B66",
      "calendarUrl": "https://bitcircus101.de/calendar/",
      "recurring": true,
      "page": true,
      "rhythm": "jeden 3. Freitag",
      "firstSeen": "2026-05-15T21:15:10.361Z"
    },
    {
      "id": "65960cd8b2aa",
      "title": "KI-Workshop: Agenten an die Leine",
      "subtitle": "",
      "description": "KI-Agenten können Server und Webseiten pflegen. Wir zeigen dir, wie du sie dabei im Griff behältst: eigener Key, eigenes Budget, jeder Token sichtbar, jede Änderung mit deinem OK. Gemeinsam entwickeln wir Workflows und testen, wie gut KI eine Website pflegen kann. Zuschauen reicht nicht, du hackst selbst mit und bringst deine Fragen und Ideen ein. Mitbringen: Erfahrung mit KI-Chats, ein Grundverständnis von Software und Netzwerken und einen eigenen Laptop. Etwa zehn Plätze, nur mit Anmeldung bis 14.11. an info+kiws26@bitcircus101.de. Gefördert vom Land NRW im Programm 2.000 x 1.000 Euro für das Engagement. Mit <3 aus Europa: THX to opper.ai 🇪🇺 💪",
      "location": "Dorotheenstraße 101, 53111 Bonn",
      "date": "2026-11-21",
      "time": "11:00",
      "endDate": "2026-11-21",
      "endTime": "18:00",
      "tags": [
        "#workshop",
        "#ai"
      ],
      "type": "workshop",
      "source": "bitcircus101",
      "uid": "059aab40-d40c-40f2-9c04-2ebeee65bce0@bitcircus101.de",
      "calendarUrl": "https://bitcircus101.de/calendar/",
      "page": true,
      "firstSeen": "2026-10-28T10:17:13.141Z"
